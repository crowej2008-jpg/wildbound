{
  "name": "wildbound",
  "version": "0.0.0",
  "private": true,
  "description": "Wildbound — original mobile-first web game built on the game-rebuild combat model.",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @wildbound/client dev",
    "build": "pnpm --parallel -r build",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "e2e": "pnpm build && playwright test",
    "sim": "pnpm --filter @wildbound/cli sim",
    "sim:golden": "pnpm --filter @wildbound/cli golden-export",
    "content:validate": "pnpm --filter @wildbound/cli content:validate",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm content:validate && pnpm e2e",
    "postinstall": "playwright install chromium"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.46.0",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.4.0",
    "vite": "^5.4.2",
    "vitest": "^2.1.1"
  }
}