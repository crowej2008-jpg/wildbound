{
  "name": "@wildbound/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Wildbound command-line tools: pnpm sim (combat simulator), golden-export, and content:validate (schema + IP guard).",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ipguard": "./src/ipguard.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "sim": "tsx src/index.ts simulate",
    "golden-export": "tsx src/index.ts golden-export",
    "content:validate": "tsx src/index.ts content:validate",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@wildbound/content": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}